generator client {
  provider = "prisma-client"
  output   = "../src/shared/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SELLER
  MANAGER
  FINANCE
  ADMIN
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum ReceivableStatus {
  PAID
  OPEN
  OVERDUE
}

enum ReceivableSource {
  ERP
  SPREADSHEET
}

enum SyncRunType {
  ERP_SYNC
  HISTORY_LOAD
}

enum SyncRunResult {
  RUNNING
  SUCCESS
  FAILURE
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  sellerCode   String?
  createdAt    DateTime @default(now())
}

model Customer {
  id               Int            @id @default(autoincrement())
  code             String         @unique
  legalName        String
  cnpj             String
  city             String
  state            String
  segment          String
  creditLimitCents Int
  sellerCode       String
  registeredAt     DateTime
  status           CustomerStatus
  erpUpdatedAt     DateTime
  syncedAt         DateTime       @updatedAt
  receivables      Receivable[]

  @@index([sellerCode])
}

model Product {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  description    String
  category       String
  unit           String
  listPriceCents Int
  active         Boolean
  erpUpdatedAt   DateTime
  syncedAt       DateTime @updatedAt
}

model Receivable {
  id             Int              @id @default(autoincrement())
  number         Int              @unique
  customerCode   String
  customer       Customer         @relation(fields: [customerCode], references: [code])
  erpOrderNumber Int?
  installment    String
  amountCents    Int
  issuedAt       DateTime
  dueAt          DateTime
  paidAt         DateTime?
  status         ReceivableStatus
  source         ReceivableSource @default(ERP)
  erpUpdatedAt   DateTime?
  syncedAt       DateTime         @updatedAt

  @@index([customerCode])
}

model SyncRun {
  id         Int           @id @default(autoincrement())
  type       SyncRunType
  entity     String
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  result        SyncRunResult @default(RUNNING)
  itemsRead     Int           @default(0)
  itemsRejected Int           @default(0)
  cursorAt      DateTime?
  error         String?
}
