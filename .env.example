NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/distrilux?schema=public
ERP_BASE_URL=https://pta-erp-api.onrender.com
# Ask the PM for the key. Never commit or log it.
ERP_API_KEY=
# Reverse proxies in front of the API (0 when none, 1 behind one platform proxy).
# Used to read the client IP for the sign-in rate limit; never set it higher.
TRUST_PROXY=0
# Automatic ERP synchronization inside the API (F02, ADR 0006): every
# SYNC_INTERVAL_MINUTES (min 5) after a success, every SYNC_RETRY_MINUTES (min 1)
# after a failure. SYNC_ENABLED is true or false.
SYNC_INTERVAL_MINUTES=60
SYNC_RETRY_MINUTES=10
SYNC_ENABLED=true
# Initial password for pnpm db:seed (F01). Run pnpm sync:erp first: sellers come
# from the synced customers. Set locally; never commit it.
SEED_DEFAULT_PASSWORD=
